
RAG_ENVIRONMENT=development
# development | test | experiment
RAG_EXECUTION_PROFILE=development
RAG_LOG_LEVEL=INFO
RAG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Required in production; optional for local health checks.
RAG_API_KEY=

# Required in experiment and production; must be independent of RAG_API_KEY.
RAG_SAFETY_IDENTIFIER_SECRET=

# Required for real agent invocation and qdrant embedding/indexing.
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-5.6
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_MODEL_MAX_RETRIES=2
RAG_MODEL_MAX_OUTPUT_TOKENS=1200
RAG_MAX_AGENT_TURNS=4
RAG_MAX_TOOL_CALLS=3

# Lexical retrieval is the offline default. Experiments require qdrant.
RAG_RETRIEVAL_BACKEND=lexical
RAG_QDRANT_URL=
RAG_QDRANT_READ_API_KEY=
RAG_QDRANT_ADMIN_API_KEY=
RAG_QDRANT_COLLECTION=phase3_enterprise_kb

# Required only when RAG_EXECUTION_PROFILE=experiment.
RAG_EXPERIMENT_RUN_ID=
RAG_EXPERIMENT_MANIFEST_DIR=artifacts/runs
