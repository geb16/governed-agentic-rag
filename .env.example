# Copy this file to .env and replace only the values needed for the selected profile.
# Never commit .env or real credentials.

# Runtime profile
# RAG_ENVIRONMENT: development | test | production
# RAG_EXECUTION_PROFILE: development | test | experiment
RAG_ENVIRONMENT=development
RAG_EXECUTION_PROFILE=development
RAG_LOG_LEVEL=INFO
RAG_API_PREFIX=/api/v1
RAG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RAG_MAX_REQUEST_BYTES=32768
RAG_MAX_QUERY_CHARS=4000

# Inbound HTTP authentication
# Required in production and recommended for an authenticated local boundary check.
RAG_API_KEY=

# Requester pseudonymization
# Required in experiment and production. Keep it independent of API and provider keys.
RAG_SAFETY_IDENTIFIER_SECRET=

# Model provider
# Required for provider-backed invocation and Qdrant ingestion.
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-5.6
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_MODEL_MAX_RETRIES=2
RAG_MODEL_MAX_OUTPUT_TOKENS=1200
RAG_MAX_AGENT_TURNS=4
RAG_MAX_TOOL_CALLS=3

# Retrieval
# Lexical is the deterministic offline default. The experiment profile requires Qdrant.
RAG_RETRIEVAL_BACKEND=lexical
RAG_KNOWLEDGE_BASE_DIR=data/knowledge_base
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=160
RAG_RETRIEVAL_TOP_K=4
RAG_RETRIEVAL_MIN_SCORE=0.01

# Qdrant
# Keep the admin key in the ingestion process only; the API uses the read key.
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_READ_API_KEY=
RAG_QDRANT_ADMIN_API_KEY=
RAG_QDRANT_COLLECTION=phase3_enterprise_kb
RAG_QDRANT_TIMEOUT_SECONDS=10

# Shared synthetic pilot persistence
RAG_SYNTHETIC_DATABASE_PATH=data/runtime/synthetic-support.db

# Experiment identity
# Both values are required when RAG_EXECUTION_PROFILE=experiment.
# RAG_EXPERIMENT_RUN_ID=run_<unique-identifier>
RAG_EXPERIMENT_MANIFEST_DIR=artifacts/runs

# Phase 4 governance security
# Grant only the allowlisted policy roles needed by the configured reviewer.
# Example values: finance_manager,fraud_reviewer,iam_administrator
RAG_GOVERNANCE_APPROVAL_PRINCIPAL_ID=local-governance-reviewer
RAG_GOVERNANCE_APPROVAL_ROLES=

# Required in experiment and production; use an independent secret of at least 32 characters.
RAG_GOVERNANCE_AUDIT_INTEGRITY_KEY=
